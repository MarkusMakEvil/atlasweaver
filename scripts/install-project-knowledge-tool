#!/usr/bin/env python3
"""Install the repository's reviewed helper as a normal uv tool."""
from __future__ import annotations

import os
from pathlib import Path
import shutil
import subprocess
import sys


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    uv = shutil.which("uv")
    if uv is None:
        print("install-project-knowledge-tool: uv is required", file=sys.stderr)
        return 1
    result = subprocess.run(
        [uv, "tool", "install", "--force", str(root)],
        env=os.environ.copy(),
        check=False,
    )
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Legacy Codex-root wrapper around the packaged AtlasWeaver agent installer."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys


sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from project_knowledge.agent_install import (  # noqa: E402
    AgentInstallError,
    _install_agent_for_platform_root,
)


SKILL_NAME = "using-project-knowledge-graphs"


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--codex-home", type=Path, required=True)
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    arguments = parse_args(argv)
    try:
        result = _install_agent_for_platform_root("codex", arguments.codex_home)
    except AgentInstallError as error:
        print(f"install-project-knowledge-skill: {error.code}", file=sys.stderr)
        return 1
    rendered = "already current" if result.status == "already_current" else result.status
    print(f"{SKILL_NAME}: {rendered}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Capture a bounded, deterministic fixture through the official Graphify CLI."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
from pathlib import PurePosixPath
import re
import stat
import sys
import tempfile

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from project_knowledge.compatibility import (
    _DIAGNOSTIC_SUMMARY_FIELDS,
    admitted_graphify_environment,
    production_graphify_compatibility,
    render_graphify_argv,
)
from project_knowledge.graphify import (
    GraphifyContractError,
    SubprocessCommandRunner,
    minimal_environment,
    resolve_graphify_executable,
    run_checked,
)


_WINDOWS_ABSOLUTE = re.compile(r"^[A-Za-z]:[\\/]|^\\\\")
_SOURCE_MANIFEST = ".atlasweaver-fixture-source.json"
_MANIFEST_MAX_BYTES = 64 * 1024
_SOURCE_FILE_MAX_BYTES = 16 * 1024 * 1024
_SOURCE_TOTAL_MAX_BYTES = 16 * 1024 * 1024


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--binary", type=Path, required=True)
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--expected-version")
    parser.add_argument("--replace", action="store_true")
    arguments = parser.parse_args()

    contract = production_graphify_compatibility()
    expected_version = arguments.expected_version or contract.version
    executable = resolve_graphify_executable(test_override=arguments.binary)
    runner = SubprocessCommandRunner()
    with tempfile.TemporaryDirectory(prefix="atlasweaver-fixture-capture-") as temporary:
        root = Path(temporary)
        root.chmod(0o700)
        source_root = root / "source"
        source_root.mkdir(mode=0o700)
        source_digest = _stage_manifest_source(arguments.source, source_root)

        environment = admitted_graphify_environment(
            contract,
            None,
            {**minimal_environment(), "HOME": str(root / "home")},
        )
        Path(environment["HOME"]).mkdir(mode=0o700)
        version = run_checked(
            runner, executable, (str(executable.path), "--version"), env=environment
        ).stdout.strip()
        if version != f"graphify {expected_version}":
            raise GraphifyContractError("Graphify fixture version mismatch")

        output_root = root / "output"
        extract = render_graphify_argv(
            contract, "extract", binary=executable.path, source=source_root,
            output=output_root, code_only=True,
        )
        run_checked(runner, executable, extract.argv, env=environment)
        native_path = output_root / "graphify-out" / "graph.json"
        native_graph = _load_json(native_path)

        diagnose = render_graphify_argv(
            contract, "diagnose", binary=executable.path, source=source_root,
            output=output_root, graph=native_path,
        )
        diagnosis = json.loads(
            run_checked(runner, executable, diagnose.argv, env=environment).stdout
        )
        summary = diagnosis.get("summary") if isinstance(diagnosis, dict) else None
        if not isinstance(summary, dict) or any(
            name not in summary for name in _DIAGNOSTIC_SUMMARY_FIELDS
        ):
            raise GraphifyContractError("Graphify fixture diagnosis is invalid")
        sanitized_diagnosis = {
            "schema_version": diagnosis.get("schema_version"),
            "summary": {name: summary[name] for name in _DIAGNOSTIC_SUMMARY_FIELDS},
        }
        normalized_graph = _normalize_paths(native_graph, source_root)
        document = {
            "schema_version": 1,
            "graphify_version": expected_version,
            "source_digest": source_digest,
            "native_graph": normalized_graph,
            "diagnosis": sanitized_diagnosis,
        }
        _reject_absolute_paths(document)
        payload = (
            json.dumps(document, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
            + "\n"
        ).encode("utf-8")
        _write_output(arguments.output, payload, replace=arguments.replace)
        print(hashlib.sha256(payload).hexdigest())
    return 0


def _load_json(path: Path) -> object:
    limit = 16 * 1024 * 1024
    descriptor = -1
    try:
        metadata = path.lstat()
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > limit:
            raise OSError("invalid fixture artifact")
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(path, flags)
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_dev != metadata.st_dev
            or opened.st_ino != metadata.st_ino
            or opened.st_size != metadata.st_size
            or opened.st_size > limit
        ):
            raise OSError("unstable fixture artifact")
        chunks: list[bytes] = []
        total = 0
        while chunk := os.read(descriptor, min(65_536, limit + 1 - total)):
            total += len(chunk)
            if total > limit:
                raise OSError("oversized fixture artifact")
            chunks.append(chunk)
        final = os.fstat(descriptor)
        if (
            final.st_dev != opened.st_dev
            or final.st_ino != opened.st_ino
            or final.st_size != opened.st_size
            or final.st_mtime_ns != opened.st_mtime_ns
            or total != opened.st_size
        ):
            raise OSError("unstable fixture artifact")
        return json.loads(b"".join(chunks).decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError):
        raise GraphifyContractError("Graphify fixture artifact is invalid") from None
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _stage_manifest_source(source: Path, target_root: Path) -> str:
    root_descriptor = -1
    try:
        before = source.lstat()
        if not stat.S_ISDIR(before.st_mode):
            raise OSError("source is not a directory")
        root_descriptor = os.open(source, _directory_open_flags())
        opened = os.fstat(root_descriptor)
        if not stat.S_ISDIR(opened.st_mode) or _object_identity(before) != _object_identity(opened):
            raise OSError("source directory identity changed")

        manifest_payload = _read_regular_at(
            root_descriptor,
            PurePosixPath(_SOURCE_MANIFEST),
            max_bytes=_MANIFEST_MAX_BYTES,
        )
        entries = _parse_source_manifest(manifest_payload)
        digest = hashlib.sha256()
        total = 0
        for relative in entries:
            remaining = _SOURCE_TOTAL_MAX_BYTES - total
            if remaining < 0:
                raise OSError("source is oversized")
            payload = _read_regular_at(
                root_descriptor,
                relative,
                max_bytes=min(_SOURCE_FILE_MAX_BYTES, remaining),
            )
            total += len(payload)
            encoded_relative = relative.as_posix().encode("utf-8")
            digest.update(len(encoded_relative).to_bytes(8, "big"))
            digest.update(encoded_relative)
            digest.update(len(payload).to_bytes(8, "big"))
            digest.update(payload)
            _write_staged_source(target_root, relative, payload)
        return digest.hexdigest()
    except (OSError, TypeError, ValueError, UnicodeError):
        raise GraphifyContractError(
            "Graphify fixture source manifest is invalid"
        ) from None
    finally:
        if root_descriptor >= 0:
            os.close(root_descriptor)


def _parse_source_manifest(payload: bytes) -> tuple[PurePosixPath, ...]:
    def reject_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
        document: dict[str, object] = {}
        for key, value in pairs:
            if key in document:
                raise ValueError("duplicate manifest key")
            document[key] = value
        return document

    document = json.loads(
        payload.decode("utf-8"), object_pairs_hook=reject_duplicate_keys
    )
    if not isinstance(document, dict) or set(document) != {"files", "schema_version"}:
        raise ValueError("invalid manifest shape")
    values = document["files"]
    if type(document["schema_version"]) is not int or document["schema_version"] != 1:
        raise ValueError("invalid manifest version")
    if not isinstance(values, list) or not values:
        raise ValueError("empty manifest inventory")
    if any(not isinstance(value, str) for value in values):
        raise ValueError("invalid manifest entry")
    if values != sorted(values) or len(values) != len(set(values)):
        raise ValueError("manifest inventory is not unique and sorted")

    entries: list[PurePosixPath] = []
    for value in values:
        components = value.split("/")
        if (
            not value
            or value.startswith("/")
            or "\\" in value
            or "\x00" in value
            or any(component in {"", ".", ".."} for component in components)
            or _WINDOWS_ABSOLUTE.match(value)
        ):
            raise ValueError("unconfined manifest entry")
        relative = PurePosixPath(value)
        if relative.name == _SOURCE_MANIFEST:
            raise ValueError("manifest cannot list itself")
        entries.append(relative)

    canonical = (
        json.dumps(document, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
        + "\n"
    ).encode("utf-8")
    if payload != canonical:
        raise ValueError("manifest is not canonical JSON")
    return tuple(entries)


def _read_regular_at(
    root_descriptor: int, relative: PurePosixPath, *, max_bytes: int
) -> bytes:
    parent_descriptor = _open_parent_at(root_descriptor, relative)
    descriptor = -1
    try:
        before = os.stat(relative.name, dir_fd=parent_descriptor, follow_symlinks=False)
        if not stat.S_ISREG(before.st_mode) or before.st_size > max_bytes:
            raise OSError("invalid source file")
        descriptor = os.open(
            relative.name,
            os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | _nofollow_flag(),
            dir_fd=parent_descriptor,
        )
        opened = os.fstat(descriptor)
        if not stat.S_ISREG(opened.st_mode) or _file_identity(before) != _file_identity(opened):
            raise OSError("source file identity changed")
        chunks: list[bytes] = []
        total = 0
        while chunk := os.read(descriptor, min(65_536, max_bytes + 1 - total)):
            total += len(chunk)
            if total > max_bytes:
                raise OSError("source file is oversized")
            chunks.append(chunk)
        final = os.fstat(descriptor)
        if _file_identity(opened) != _file_identity(final) or total != opened.st_size:
            raise OSError("source file changed during capture")
        return b"".join(chunks)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent_descriptor)


def _open_parent_at(root_descriptor: int, relative: PurePosixPath) -> int:
    descriptor = os.dup(root_descriptor)
    try:
        for component in relative.parts[:-1]:
            child = os.open(component, _directory_open_flags(), dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _directory_open_flags() -> int:
    try:
        return os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    except AttributeError as error:
        raise OSError("no-follow directory opens unavailable") from error


def _nofollow_flag() -> int:
    try:
        return os.O_NOFOLLOW
    except AttributeError as error:
        raise OSError("no-follow file opens unavailable") from error


def _object_identity(info: os.stat_result) -> tuple[int, int]:
    return (info.st_dev, info.st_ino)


def _file_identity(info: os.stat_result) -> tuple[int, int, int, int, int]:
    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)


def _write_staged_source(root: Path, relative: PurePosixPath, payload: bytes) -> None:
    parent = root
    for component in relative.parts[:-1]:
        parent = parent / component
        parent.mkdir(mode=0o700, exist_ok=True)
        os.chmod(parent, 0o700)
    target = root.joinpath(*relative.parts)
    descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise OSError("short staged source write")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _normalize_paths(value: object, source_root: Path) -> object:
    if isinstance(value, dict):
        return {key: _normalize_paths(item, source_root) for key, item in value.items()}
    if isinstance(value, list):
        return [_normalize_paths(item, source_root) for item in value]
    if isinstance(value, str):
        source = str(source_root)
        if value == source:
            return "fixture"
        if value.startswith(source + os.sep):
            return "fixture/" + value[len(source + os.sep):].replace(os.sep, "/")
    return value


def _reject_absolute_paths(value: object) -> None:
    if isinstance(value, dict):
        for key, item in value.items():
            _reject_absolute_paths(key)
            _reject_absolute_paths(item)
    elif isinstance(value, list):
        for item in value:
            _reject_absolute_paths(item)
    elif isinstance(value, str) and (value.startswith("/") or _WINDOWS_ABSOLUTE.match(value)):
        raise GraphifyContractError("fixture contains an absolute path")


def _write_output(path: Path, payload: bytes, *, replace: bool) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT
    flags |= os.O_TRUNC if replace else os.O_EXCL
    descriptor = os.open(path, flags, 0o600)
    try:
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


if __name__ == "__main__":
    raise SystemExit(main())
